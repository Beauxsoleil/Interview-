# Copy to .env and fill in as needed. All values are optional.

# --- Gemini profile extraction ---
# Without this, transcription still works but profile extraction is disabled.
GEMINI_API_KEY=
PROFILE_MODEL=gemini-3.6-flash

# --- Upload and browser security ---
MAX_UPLOAD_BYTES=524288000
MAX_AUDIO_DURATION_SECONDS=7200
MIN_FREE_DISK_BYTES=1073741824
# JSON array of explicitly allowed development origins.
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# Enable only when requests are always served over HTTPS.
ENABLE_HSTS=false
BACKUP_RETENTION_COUNT=14

# --- PIBASE Firestore sync (server-side only) ---
# Store this JSON outside the repository and restrict it to the service account.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=pi-base-a3a09

# --- Pipeline backend ---
# auto  -> use whisper/whisperx + pyannote if installed, otherwise the stub
# stub  -> always use the built-in sample-transcript backend (no ML deps)
PIPELINE_BACKEND=auto
WHISPER_MODEL=base
# Long recordings are decoded to mono 16 kHz audio, processed in bounded
# windows, and merged back onto the original timeline. Keep batch size at 1 on
# constrained hosts; raise it only after testing representative recordings.
TRANSCRIPTION_CHUNK_SECONDS=300
TRANSCRIPTION_OVERLAP_SECONDS=8
TRANSCRIPTION_BATCH_SIZE=1

# --- Diarization (pyannote) ---
# Required to download the pyannote/speaker-diarization-3.1 model.
HF_TOKEN=
# Optional: fix the number of speakers (leave blank to auto-detect).
DEFAULT_NUM_SPEAKERS=
