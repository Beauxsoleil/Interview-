<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Read recordings the user explicitly picks in the open panel. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Deliberately absent: com.apple.security.network.client.
         Transcription, summarization, and profile extraction all run on device,
         so the app needs no outbound network access at all. Leaving this out
         means the sandbox will block any accidental network call. -->
</dict>
</plist>
